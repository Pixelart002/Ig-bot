# Hugging Face Inference API
HF_TOKEN=your_huggingface_token
HF_MODEL=Qwen/Qwen2.5-7B-Instruct-1M

# AI backend (the Ollama token falls back to HF_TOKEN when omitted)
OLLAMA_URL=https://your-ollama-service.example.com
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Optional: comma-separated Telegram user/chat IDs allowed to control the bot
TELEGRAM_ALLOWED_USER_IDS=
# Super admins receive live per-user activity/audit events
SUPER_ADMIN_USER_IDS=

# Public HTTPS URL of this service for the one-time verification session link
VERIFICATION_BASE_URL=https://your-service.example.com

# Lightpanda Cloud CDP WebSocket (keep the token secret)
CDP_URL=wss://euwest.cloud.lightpanda.io/ws?token=your_lightpanda_token
# Optional local CDP endpoint settings for tools that expose a local debugger.
CDP_HOST=127.0.0.1
CDP_PORT=9222

VERIFICATION_HOST=0.0.0.0
VERIFICATION_PORT=8080

# Legacy fixed signup fields are intentionally not used for generated accounts.
# Keep real credentials out of git and use hosting secrets where required.
